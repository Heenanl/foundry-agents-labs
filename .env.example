# Foundry project endpoint
# Format: https://<resource>.services.ai.azure.com/api/projects/<project>
FOUNDRY_PROJECT_ENDPOINT="https://<your-resource>.services.ai.azure.com/api/projects/<your-project>"

# Name of a deployed chat model in your project (e.g. gpt-4.1, gpt-5-mini)
AZURE_AI_MODEL_DEPLOYMENT_NAME="gpt-4.1"

# Labs 2 & 4 (RAG)
AZURE_SEARCH_ENDPOINT="https://<your-search>.search.windows.net"
AZURE_SEARCH_INDEX_NAME="contoso-outdoors"

# Lab 2 (prompt-agent RAG) only - the name of the Azure AI Search
# connection configured in your Foundry project
AZURE_SEARCH_CONNECTION_NAME="<your-search-connection-name>"

# Lab 6, step 4 (grant the hosted agent's identity read access) - full ARM resource id:
# /subscriptions/<sub>/resourceGroups/<rg>/providers/Microsoft.Search/searchServices/<name>
AZURE_SEARCH_SERVICE_ID="<paste-search-service-resource-id>"
